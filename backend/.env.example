# Local docker Qdrant:
QDRANT_HOST=localhost
QDRANT_PORT=6333
# ...or a hosted cluster (Qdrant Cloud) -- when QDRANT_URL is set, host/port are ignored:
# QDRANT_URL=https://xxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-key
COLLECTION_NAME=thirukural

EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2

TOP_K=5
SEARCH_LIMIT_RAW=20

GEMINI_API_KEY=your-key-here
EXPLAIN_MODEL_NAME=gemini-3.5-flash-lite

LOG_LEVEL=INFO
