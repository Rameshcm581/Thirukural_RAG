# Vector DB (Local Qdrant or Qdrant Cloud):
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud (URL overrides host/port):
# QDRANT_URL=https://xxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-key
COLLECTION_NAME=thirukural

# PostgreSQL Database (Supabase, Neon, or local):
DATABASE_URL=postgresql://postgres:password@localhost:5432/pgdb

# Embedding Provider:
# "gemini" uses Gemini text-embedding-004 API (lightweight, runs within Render free tier)
# "local" uses SentenceTransformer (requires ~1.5GB RAM)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=text-embedding-004

TOP_K=5
SEARCH_LIMIT_RAW=20

# Google Gemini API (used for embeddings and grounded explanations):
GEMINI_API_KEY=your-key-here
EXPLAIN_MODEL_NAME=gemini-2.5-flash

LOG_LEVEL=INFO
